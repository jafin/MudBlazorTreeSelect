@namespace MudBlazorTreeSelect.Tests.Components
<MudPopoverProvider />

<TreeSelect T="string" @bind-Value="Value" Label="Category">
    <TreeSelectItem Value="@("fruit")" NestedList="@(ShowChildren ? FruitChildren : null)">Fruit</TreeSelectItem>
    <TreeSelectItem Value="@("dairy")">Dairy</TreeSelectItem>
</TreeSelect>

@code {
    public static string __description__ = "A select whose first item only gets a nested list after it has rendered.";

    [Parameter] public string? Value { get; set; }
    [Parameter] public bool ShowChildren { get; set; }

    private RenderFragment FruitChildren =>
        @<text>
            <TreeSelectItem Value="@("apples")">Apples</TreeSelectItem>
            <TreeSelectItem Value="@("bananas")">Bananas</TreeSelectItem>
        </text>;
}
