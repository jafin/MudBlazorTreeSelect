<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MudBlazorTreeSelect.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The tests read the component's Value from outside, which the MudBlazor analyzer discourages in app code. -->
    <NoWarn>$(NoWarn);CS1591;NU1507;MUD0012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="bunit" Version="2.13.3" />
    <PackageReference Include="nunit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MudBlazorTreeSelect\MudBlazorTreeSelect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MudBlazor" />
    <Using Include="MudBlazorTreeSelect" />
    <Using Include="NUnit.Framework" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
